# PostgreSQL connection string.
# In WSL, PostgreSQL listens on localhost. Note that some WSL installations
# use a non-default port (e.g. 5433) — check with `pg_lsclusters` and adjust.
DATABASE_URL=postgresql://postgres:password@localhost:5432/mawinguops

# Africa's Talking credentials (USSD delivery)
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=your_africastalking_username
AT_SHORTCODE=*384#

# Groq API key + model (Llama advisory text generation)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# Optional override; defaults to Groq's OpenAI-compatible endpoint.
# GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# Open-Meteo forecast API (no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# SPI reference period (calibrate_spi.py). ICPAC's East Africa Drought Watch
# fits SPI on 1981-2010. Set these to match it exactly once the full CHIRPS
# archive (from 1981) is loaded; unset = use all available years.
# SPI_REF_START_YEAR=1981
# SPI_REF_END_YEAR=2010

# Optional: ICPAC official growing-season onset (validate_onset.py). A digilib
# Ingrid URL (digilib.icpac.net) returning CSV with onset day-of-year/date for
# Machakos. Unset = the CHIRPS climatology is used as the onset reference.
# ICPAC_ONSET_URL=

# Machakos County coordinates
MACHAKOS_LAT=-1.5177
MACHAKOS_LON=37.2634

# API server
PORT=3000
NODE_ENV=development

# --- Multi-channel broadcast (broadcast_advisory.py + admin console) --------
# Resend transactional email API key (email subscriptions). Missing key =
# email sends are logged as dry runs instead of failing.
RESEND_API_KEY=your_resend_api_key
# From-address for advisory emails (Resend-verified domain or onboarding@resend.dev).
# EMAIL_FROM=MawinguOps <onboarding@resend.dev>
# Optional Africa's Talking alphanumeric sender id / shortcode for outbound SMS.
# AT_SENDER_ID=
# Force the broadcast step to log dry runs instead of calling AT/Resend.
# BROADCAST_DRY_RUN=true

# Bearer token protecting GET /api/admin/overview and the /admin dashboard view.
ADMIN_TOKEN=change_me_admin_token
